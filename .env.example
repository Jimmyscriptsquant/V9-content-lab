# ===========================================
# V9 CONTENT LAB - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# Only MONGODB_URI is strictly required to run locally

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ===========================================
# DATABASE (MongoDB) - REQUIRED
# ===========================================
# Free cluster: https://www.mongodb.com/atlas/database
MONGODB_URI=

# ===========================================
# AUTHENTICATION (NextAuth) - REQUIRED
# ===========================================
NEXTAUTH_URL=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=039fe00d761b0292567fa027dda8b1fa2de425b49fd2cbbe046bbefeb0548554

# Dev login: log in with any email + this password (dev mode only)
DEV_LOGIN_PASSWORD=test123

# Google OAuth (optional)
GOOGLE_ID=
GOOGLE_SECRET=

# ===========================================
# ENCRYPTION
# ===========================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=a40ae22af33af4d10470ab15ed76c473770cb5842ca99a3a9b3c4da61e967600

# ===========================================
# PAYMENTS (Stripe) - optional for local dev
# ===========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ===========================================
# AI PROVIDERS
# ===========================================

# OpenAI (text via GPT-4o-mini, images via DALL-E 3, voice via TTS-1)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude (optional, for text)
ANTHROPIC_API_KEY=

# Kling AI (video generation)
KLING_API_KEY=AF4peKCp8PEnRaQfbtY9ebap83hafJkH
KLING_API_SECRET=PaPMrLtDtgY3MtC8afgE4aEpKhtGANHN

# ElevenLabs (optional voice generation)
ELEVENLABS_API_KEY=

# ===========================================
# SOCIAL PLATFORM APIs (for publishing)
# ===========================================

# Twitter/X OAuth 2.0
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ===========================================
# EMAIL (Resend) - optional
# ===========================================
RESEND_API_KEY=

# ===========================================
# FILE STORAGE (AWS S3) - optional
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=v9-content-lab
