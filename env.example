# ============================================================
# V9 Content Lab — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
#
# MINIMUM for local dev (login + API keys + content):
#   NEXTAUTH_SECRET, MONGODB_URI, DEV_LOGIN_PASSWORD
#
# AI generation also needs OPENAI_API_KEY (text/image fallback
# works without it, but real generation requires it).
# ============================================================

# ── Auth ─────────────────────────────────────────────────────
# Any random string ≥32 chars (auto-fallback in dev, but set it anyway)
NEXTAUTH_SECRET=replace_with_random_32+_chars

# Google OAuth (optional — skip if using DEV_LOGIN_PASSWORD)
GOOGLE_ID=
GOOGLE_SECRET=

# Dev-only credentials login (set any password; works with any email)
# e.g. DEV_LOGIN_PASSWORD=test123
DEV_LOGIN_PASSWORD=

# ── Database ─────────────────────────────────────────────────
# REQUIRED for all dashboard features (content, API keys, brand kit)
# Free tier: https://www.mongodb.com/atlas/database  →  Create cluster
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/v9contentlab?retryWrites=true&w=majority

# ── Encryption ───────────────────────────────────────────────
# 32-byte hex key for encrypting OAuth tokens (not needed for API keys).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Payments (Stripe) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=

# ── AI Providers ─────────────────────────────────────────────
# OpenAI (text via GPT, images via DALL-E 3, voice via TTS)
OPENAI_API_KEY=

# Anthropic (alternative text provider)
ANTHROPIC_API_KEY=

# ElevenLabs (alternative voice provider)
ELEVENLABS_API_KEY=

# Kling AI (video / reel generation)
KLING_API_KEY=
KLING_API_SECRET=

# ── Optional ─────────────────────────────────────────────────
# Redis for rate limiting / queues
REDIS_URL=
